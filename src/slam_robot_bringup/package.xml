<?xml version="1.0"?>
<package format="3">
  <name>slam_robot_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and controller settings for the slam-robot on the Raspberry Pi (ROS 2 Humble).</description>
  <maintainer email="dev@slam-robot.local">slam-robot</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>slam_robot_description</exec_depend>
  <exec_depend>slam_robot_hardware</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_robot_imu</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
