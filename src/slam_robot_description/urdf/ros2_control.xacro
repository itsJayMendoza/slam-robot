<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Wheel velocity commands and position/velocity states in rad and rad/s.
       use_mock: ros2_control's mock hardware, to test the controllers without the robot. -->
  <xacro:macro name="slam_robot_ros2_control" params="use_mock port">
    <ros2_control name="SlamRobotBase" type="system">
      <hardware>
        <xacro:if value="${use_mock}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </xacro:if>
        <xacro:unless value="${use_mock}">
          <plugin>slam_robot_hardware/SlamRobotSystem</plugin>
          <param name="port">${port}</param>
          <!-- 217,200 counts per metre (2 m floor test) x 2 pi x 0.036 m wheel radius -->
          <param name="counts_per_rev">49130</param>
          <param name="max_cps">50000</param>
        </xacro:unless>
      </hardware>
      <xacro:macro name="wheel_joint" params="name">
        <joint name="${name}">
          <command_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </xacro:macro>
      <xacro:wheel_joint name="wheel_left_joint"/>
      <xacro:wheel_joint name="wheel_right_joint"/>
    </ros2_control>
  </xacro:macro>
</robot>
