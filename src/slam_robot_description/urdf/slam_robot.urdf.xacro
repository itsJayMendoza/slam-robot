<?xml version="1.0"?>
<!-- slam-robot. All lengths in metres, measured on the real robot.
     Frames: base_footprint on the floor under the middle of the wheel axle; base_link on the axle
     (the point the robot turns about); x forward (towards the caster), y left, z up.
     Chassis: the 3D-printed design in meshes/ (README there): wheels on the motors at the chassis
     centre, a single front caster, lidar and IMU at the chassis' mounts. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="slam_robot">
  <xacro:arg name="use_mock" default="false"/>
  <xacro:arg name="port" default="/dev/esp32"/>
  <!-- verified 0: with ydlidar_x3.yaml (reversion, inverted true) a box 50 cm ahead reads at 0 deg and
       one on the left at +90 deg -->
  <xacro:arg name="laser_yaw" default="0.0"/>

  <xacro:property name="wheel_radius" value="0.036"/>       <!-- 72 mm wheels -->
  <xacro:property name="wheel_width" value="0.035"/>
  <xacro:property name="wheel_separation" value="0.180"/>   <!-- tyre centre to tyre centre -->
  <!-- the chassis meshes (meshes/README.md) are for 65 mm wheels: scale them to ours -->
  <xacro:property name="wheel_scale_r" value="${0.036 / 0.0325}"/>
  <xacro:property name="wheel_scale_w" value="${0.035 / 0.0298}"/>
  <xacro:property name="wheel_mesh_mid" value="${0.0141 * 0.035 / 0.0298}"/>
  <xacro:property name="mesh" value="package://slam_robot_description/meshes"/>

  <material name="body"><color rgba="0.15 0.15 0.15 1"/></material>
  <material name="wheel"><color rgba="0.9 0.6 0.1 1"/></material>
  <material name="sensor"><color rgba="0.2 0.4 0.9 1"/></material>

  <link name="base_footprint"/>
  <link name="base_link">
    <visual>
      <geometry><mesh filename="${mesh}/base_link.STL"/></geometry>
      <material name="body"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0275"/>
      <geometry><box size="0.138 0.127 0.103"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04"/>
      <mass value="1.2"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}"/>
  </joint>

  <!-- joints at the tyre centres; the wheel mesh starts at its inner face, hence the visual offset -->
  <xacro:macro name="wheel" params="side y roll">
    <link name="wheel_${side}_link">
      <visual>
        <origin xyz="0 ${-y / fabs(y) * wheel_mesh_mid} 0" rpy="${roll} 0 0"/>
        <geometry>
          <mesh filename="${mesh}/wheel_${side}_link.STL"
                scale="${wheel_scale_r} ${wheel_scale_r} ${wheel_scale_w}"/>
        </geometry>
        <material name="wheel"/>
      </visual>
      <collision>
        <origin rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="2e-5" ixy="0" ixz="0" iyy="3e-5" iyz="0" izz="2e-5"/>
      </inertial>
    </link>
    <joint name="wheel_${side}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="wheel_${side}_link"/>
      <origin xyz="0 ${y} 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <xacro:wheel side="left" y="${wheel_separation / 2}" roll="${-pi / 2}"/>
  <xacro:wheel side="right" y="${-wheel_separation / 2}" roll="${pi / 2}"/>

  <!-- one front caster at the chassis' front caster mount (this robot has no rear caster) -->
  <link name="caster_link">
    <visual>
      <geometry><mesh filename="${mesh}/caster_front_link.STL"/></geometry>
      <material name="body"/>
    </visual>
    <collision><geometry><sphere radius="0.005"/></geometry></collision>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="0.04755 0 ${0.0055 - wheel_radius}"/>
  </joint>

  <!-- MPU6050 in the middle of the body, at the chassis' IMU mount (its height does not matter: only the
       yaw rate is used). Z up verified (90 deg counterclockwise read +90), X assumed forward. -->
  <link name="imu_link">
    <visual>
      <geometry><mesh filename="${mesh}/imu_link.STL"/></geometry>
      <material name="sensor"/>
    </visual>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.0699"/>
  </joint>

  <!-- YDLidar X3: centre 40 mm ahead of the wheel axle; height from the chassis' lidar mount
       (a 2D scan does not depend on it). Drawn with the RPLIDAR A1 mesh, which stays put while
       laser_yaw turns the scan frame. -->
  <link name="laser_link">
    <visual>
      <origin rpy="0 0 ${-$(arg laser_yaw)}"/>
      <geometry><mesh filename="${mesh}/laser_link.STL"/></geometry>
      <material name="sensor"/>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.040 0 0.1208" rpy="0 0 $(arg laser_yaw)"/>
  </joint>

  <xacro:include filename="$(find slam_robot_description)/urdf/ros2_control.xacro"/>
  <xacro:slam_robot_ros2_control use_mock="$(arg use_mock)" port="$(arg port)"/>
</robot>
